[Unit]
Description=gabi.brain escuta do WhatsApp: ingere o spool do ouvinte, classifica e processa (só contagens no log)
After=gabi-brain-fontes.service
OnFailure=gabi-brain-falha@%n.service
Wants=gabi-brain-fontes.service

[Service]
Type=oneshot
User=gabibrain
Group=gabibrain
WorkingDirectory=/opt/gabi-brain
Environment=GABI_BANCO=/var/lib/gabi-brain/gabi.db
Environment=GABI_ESCUTA_SPOOL=/var/lib/gabi-brain/escuta-spool
# O modelo (OpenRouter) e o Paperless chegam pela ponte do serviço de fontes (único com rede e chaves, R5): aqui não há chave nem rede.
Environment=GABI_FONTES_SOCKET=/run/gabi-brain-fontes/fontes.sock
ExecStart=/opt/gabi-brain/venv/bin/python -m gabi.escuta
TimeoutStartSec=600
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
ReadWritePaths=/var/lib/gabi-brain /var/lib/gabi-brain/escuta-spool
