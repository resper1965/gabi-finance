[Unit]
Description=gabi-finance avisos: o que o Ricardo precisa saber (rodada parada, conta atrasada, assinatura cancelada e cobrada, vence hoje)
After=gabi-finance-api.service
OnFailure=gabi-finance-falha@%n.service

[Service]
Type=oneshot
User=gabifinance
Group=gabifinance
WorkingDirectory=/opt/gabi-finance
Environment=GABI_BANCO=/var/lib/gabi-finance/gabi.db
ExecStart=/opt/gabi-finance/venv/bin/python -m gabi.avisos
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/gabi-finance
