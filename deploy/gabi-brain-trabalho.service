[Unit]
Description=gabi.brain trabalho: e-mail, agenda e tarefas das caixas liberadas (só leitura; conclui tarefa pedida no painel)
After=network-online.target
OnFailure=gabi-brain-falha@%n.service
Wants=network-online.target

[Service]
Type=oneshot
User=gabibrain
Group=gabibrain
WorkingDirectory=/opt/gabi-brain
Environment=GABI_BANCO=/var/lib/gabi-brain/gabi.db
# Credenciais do Graph e do Google (colocadas por você, nunca no código); "-" = sobe sem o arquivo e cada caixa pede "reconectar".
EnvironmentFile=-/etc/gabi/trabalho.env
ExecStart=/opt/gabi-brain/venv/bin/python -m gabi.trabalho
TimeoutStartSec=900
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/gabi-brain
