[Unit]
Description=gabi.brain anexos: copia imagem e áudio do cache do Hermes para o disco do brain (caixa de entrada dos projetos)
After=gabi-brain-api.service
OnFailure=gabi-brain-falha@%n.service

[Service]
Type=oneshot
User=gabibrain
Group=gabibrain
WorkingDirectory=/opt/gabi-brain
Environment=GABI_BANCO=/var/lib/gabi-brain/gabi.db
Environment=ANEXOS_ORIGENS=/var/lib/gabi-brain/anexos-entrada/images:/var/lib/gabi-brain/anexos-entrada/audio
Environment=ANEXOS_DIR=/var/lib/gabi-brain/anexos
# O cache do Hermes é 0700 do usuário ricardo: o "+" roda como root (fora da sandbox, como o ExecStartPost do gabi-wa-docs) só para copiar o que é novo
# (selo de data) para a entrada do brain; o Python abaixo roda como gabibrain. A entrada é limpa depois de 2 dias; o anexo guardado é o do ANEXOS_DIR.
ExecStartPre=+/bin/sh -c 'D=/var/lib/gabi-brain/anexos-entrada; S=$D/.selo; mkdir -p $D/images $D/audio; touch $S.novo; for t in images audio; do if [ -f $S ]; then find /home/ricardo/.hermes/cache/$t -maxdepth 1 -type f -newer $S -exec cp -p -t $D/$t {} +; else find /home/ricardo/.hermes/cache/$t -maxdepth 1 -type f -exec cp -p -t $D/$t {} +; fi; done; chown -R gabibrain:gabibrain $D; chmod -R go-rwx $D; mv $S.novo $S'
ExecStart=/opt/gabi-brain/venv/bin/python -m gabi.anexos
ExecStartPost=+/bin/sh -c 'find /var/lib/gabi-brain/anexos-entrada -type f -mtime +2 -delete'
TimeoutStartSec=300
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
ReadWritePaths=/var/lib/gabi-brain
