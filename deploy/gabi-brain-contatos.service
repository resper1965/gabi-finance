[Unit]
Description=gabi.brain contatos (só nome e telefone): sincroniza pela ponte e grava contato_google; escreve no Graph da ness só propostas aprovadas pelo dono e com contatos.escrita ligado (só contagens no log)
After=gabi-brain-fontes.service
OnFailure=gabi-brain-falha@%n.service
Wants=gabi-brain-fontes.service

[Service]
Type=oneshot
User=gabibrain
Group=gabibrain
WorkingDirectory=/opt/gabi-brain
Environment=GABI_BANCO=/var/lib/gabi-brain/gabi.db
# Os contatos chegam pela ponte do serviço de fontes (único com rede e segredos, R5): aqui não há token nem rede.
Environment=GABI_FONTES_SOCKET=/run/gabi-brain-fontes/fontes.sock
ExecStart=/opt/gabi-brain/venv/bin/python -m gabi.escuta.contatos
# Depois da sincronização: aplica só as propostas APROVADAS no painel; com contatos.escrita desligado (padrão) só conta o que aplicaria.
ExecStartPost=/opt/gabi-brain/venv/bin/python -m gabi.escuta.contatos_gravar
TimeoutStartSec=300
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
ReadWritePaths=/var/lib/gabi-brain
