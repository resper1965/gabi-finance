[Unit]
Description=gabi.brain MCP (leitura; só 127.0.0.1:8081; exige token Bearer)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=gabibrain
Group=gabibrain
WorkingDirectory=/opt/gabi-brain
Environment=GABI_BANCO=/var/lib/gabi-brain/gabi.db
# Hosts aceitos (anti DNS-rebinding). Para expor na tailnet: tailscale serve --https=8443 http://127.0.0.1:8081 e acrescente
# o nome da máquina (ex.: gabi.<tailnet>.ts.net:8443) aqui por drop-in.
Environment=GABI_MCP_HOSTS=127.0.0.1:8081,localhost:8081
# Paperless e Nibo vivem no serviço gabi-brain-fontes (esta unidade não tem rede nem tokens).
Environment=GABI_FONTES_SOCKET=/run/gabi-brain-fontes/fontes.sock
ExecStart=/opt/gabi-brain/venv/bin/uvicorn --factory gabi.mcp.servidor:fabrica --host 127.0.0.1 --port 8081 --no-proxy-headers
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
ReadWritePaths=/var/lib/gabi-brain
MemoryMax=1G

[Install]
WantedBy=multi-user.target
