[Unit]
Description=gabi.brain exames em PDF do Paperless: extrai e PROPÕE no cofre cifrado (nunca confirma o dono); só contagens no log
After=gabi-brain-fontes.service
OnFailure=gabi-brain-falha@%n.service
Wants=gabi-brain-fontes.service

[Service]
Type=oneshot
User=gabibrain
Group=gabibrain
WorkingDirectory=/opt/gabi-brain
Environment=GABI_BANCO=/var/lib/gabi-brain/gabi.db
# O Paperless e o modelo chegam pela ponte do serviço de fontes (único com rede e segredos, R5): aqui não há token nem rede.
Environment=GABI_FONTES_SOCKET=/run/gabi-brain-fontes/fontes.sock
# A chave do cofre de saúde (ADR-014) é o mesmo arquivo que a API usa (root:gabibrain 0640, colocado pelo Ricardo). Sem ela o serviço não roda e avisa.
Environment=GABI_SAUDE_CHAVE_ARQUIVO=/etc/gabi/saude.key
ExecStart=/opt/gabi-brain/venv/bin/python -m gabi.familia
TimeoutStartSec=900
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
ReadWritePaths=/var/lib/gabi-brain
