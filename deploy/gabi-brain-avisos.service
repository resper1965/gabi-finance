[Unit]
Description=gabi.brain avisos: o que o Ricardo precisa saber (rodada parada, conta atrasada, assinatura cancelada e cobrada, vence hoje)
After=gabi-brain-api.service
OnFailure=gabi-brain-falha@%n.service

[Service]
Type=oneshot
User=gabibrain
Group=gabibrain
WorkingDirectory=/opt/gabi-brain
Environment=GABI_BANCO=/var/lib/gabi-brain/gabi.db
ExecStart=/opt/gabi-brain/venv/bin/python -m gabi.avisos
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/gabi-brain
