[Unit]
Description=gabi.brain comprovantes Pix do Paperless: lê o texto, grava e PROPÕE vínculos (nunca confirma)
After=gabi-brain-fontes.service
OnFailure=gabi-brain-falha@%n.service
Wants=gabi-brain-fontes.service

[Service]
Type=oneshot
User=gabibrain
Group=gabibrain
WorkingDirectory=/opt/gabi-brain
Environment=GABI_BANCO=/var/lib/gabi-brain/gabi.db
# O Paperless é lido pela ponte do serviço de fontes (único com rede e token, R5): este processo não tem token nem rede.
Environment=GABI_FONTES_SOCKET=/run/gabi-brain-fontes/fontes.sock
ExecStart=/opt/gabi-brain/venv/bin/python -m gabi.cobrar.ingestao
TimeoutStartSec=900
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/gabi-brain
