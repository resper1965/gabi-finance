[Unit]
Description=gabi-finance exportação semanal do banco, criptografada, para fora da VPS
OnFailure=gabi-finance-falha@%n.service
ConditionPathExists=/etc/gabi-finance/backup.pub

[Service]
Type=oneshot
User=gabifinance
Group=gabifinance
WorkingDirectory=/opt/gabi-finance
ExecStart=/opt/gabi-finance/venv/bin/python -m gabi.exportacao --banco /var/lib/gabi-finance/gabi.db --destino /var/backups/gabi-finance/exportacao --chave /etc/gabi-finance/backup.pub
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
ReadWritePaths=/var/lib/gabi-finance /var/backups/gabi-finance
