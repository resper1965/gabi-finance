[Unit]
Description=gabi.brain backup diário do banco, com teste de restauração

[Service]
Type=oneshot
User=gabibrain
Group=gabibrain
WorkingDirectory=/opt/gabi-brain
ExecStart=/opt/gabi-brain/venv/bin/python -m gabi.backup --banco /var/lib/gabi-brain/gabi.db --destino /var/backups/gabi-brain --testar
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/gabi-brain /var/backups/gabi-brain
