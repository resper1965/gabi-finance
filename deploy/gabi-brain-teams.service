[Unit]
Description=gabi.brain Teams da ness: lê os chats pela ponte (só metadados, sem texto) e avisa o que está sem resposta; só contagens no log
After=gabi-brain-fontes.service
OnFailure=gabi-brain-falha@%n.service
Wants=gabi-brain-fontes.service

[Service]
Type=oneshot
User=gabibrain
Group=gabibrain
WorkingDirectory=/opt/gabi-brain
Environment=GABI_BANCO=/var/lib/gabi-brain/gabi.db
# O Teams chega pela ponte do serviço de fontes (único com rede e segredos, R5): aqui não há token nem rede.
Environment=GABI_FONTES_SOCKET=/run/gabi-brain-fontes/fontes.sock
ExecStart=/opt/gabi-brain/venv/bin/python -m gabi.teams
TimeoutStartSec=300
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
ReadWritePaths=/var/lib/gabi-brain
