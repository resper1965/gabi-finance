[Unit]
Description=gabi.brain API (escuta só em 127.0.0.1; exposta pelo tailscale serve)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=gabibrain
Group=gabibrain
WorkingDirectory=/opt/gabi-brain
Environment=GABI_BANCO=/var/lib/gabi-brain/gabi.db
ExecStart=/opt/gabi-brain/venv/bin/uvicorn --factory gabi.api:fabrica --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/gabi-brain
MemoryMax=1G

[Install]
WantedBy=multi-user.target
