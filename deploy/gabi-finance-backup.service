[Unit]
Description=gabi.brain backup diário do banco, com teste de restauração
OnFailure=gabi-brain-falha@%n.service

[Service]
Type=oneshot
User=gabibrain
Group=gabibrain
WorkingDirectory=/opt/gabi-brain
ExecStart=/opt/gabi-brain/venv/bin/python -m gabi.backup --banco /var/lib/gabi-brain/gabi.db --destino /var/backups/gabi-brain --testar
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
ReadWritePaths=/var/lib/gabi-brain /var/backups/gabi-brain
