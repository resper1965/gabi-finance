[Unit]
Description=gabi-finance backup diário do banco, com teste de restauração
OnFailure=gabi-finance-falha@%n.service

[Service]
Type=oneshot
User=gabifinance
Group=gabifinance
WorkingDirectory=/opt/gabi-finance
ExecStart=/opt/gabi-finance/venv/bin/python -m gabi.backup --banco /var/lib/gabi-finance/gabi.db --destino /var/backups/gabi-finance --testar
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
ReadWritePaths=/var/lib/gabi-finance /var/backups/gabi-finance
